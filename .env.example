# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env and edit. Setup walkthrough is in README.md.
#
# Values reach the container LITERALLY, so a trailing "# comment" on a KEY=VALUE
# line becomes part of the value. Keep comments on their own lines.
#
# Max players, autosave interval and the RCON port are NOT env vars in this
# image. Edit them in server-data/Zomboid/Server/<SERVERNAME>.ini after first boot.
# ─────────────────────────────────────────────────────────────────────────────

# ── playit.gg ────────────────────────────────────────────────────────────────
# Headless agent key. Get it from the Docker path, which is easy to miss in the
# site's menus (the claim-URL flow is the desktop app, a different binary):
#   https://playit.gg/account/setup/wizard/new-account/docker/docker-name
# Without this the server runs but nobody can join over the internet.
PLAYIT_SECRET_KEY=

# ── Server identity ──────────────────────────────────────────────────────────
SERVERNAME=servername
# What friends type to join. Empty means no password.
PASSWORD=changeme-join
ADMINUSERNAME=admin
# The server refuses to start on first boot without this.
ADMINPASSWORD=changeme-admin

# ── Networking, tuned for a playit tunnel. Change with care. ─────────────────
# playit forwards to the fixed bridge IP on 16261; the game takes 16262 itself.
PORT=16261
UDPPORT=16262
# Direct-connect is the path that works through a tunnel. If players still can't
# join, try NOSTEAM=False and toggling "Use Steam Relay" client side.
NOSTEAM=True
STEAMVAC=False
# The in-game browser would advertise the wrong address behind a tunnel.
PUBLIC=False

# ── RCON. Port stays 27015/tcp and is not published to the host; the .ini
#    changes it. ────────────────────────────────────────────────────────────
RCONPASSWORD=changeme-rcon

# ── Mods (optional) ──────────────────────────────────────────────────────────
# Semicolon-separated. Downloading them needs SteamCMD, which means one run with
# FORCEUPDATE=True, and that is the 32-bit path that's unreliable on ARM64 hosts.
# A vanilla server needs none of this.
MOD_IDS=
WORKSHOP_IDS=
# FORCEUPDATE=True

# ── JVM / resources ──────────────────────────────────────────────────────────
# Java heap. Keep MAX_MEMORY well below CONTAINER_MEMORY, aiming to leave 20% or
# so free: the container also needs non-heap JVM memory, PZ native memory and
# emulation overhead, and if the total crosses CONTAINER_MEMORY the kernel
# OOM-kills it with no chance to save.
MIN_MEMORY=2048m
MAX_MEMORY=8192m
TZ=UTC

# ── Deployment knobs (substituted into docker-compose.yaml) ──────────────────
# If you raise CONTAINER_MEMORY, raise your Docker Desktop / OrbStack VM RAM to
# fit and keep it under the machine's physical RAM, or the container never
# actually gets it.
CONTAINER_MEMORY=10g
CONTAINER_CPUS=8
# Numeric, no "s" suffix.
# STOP_GRACE=120
# Prefix for container names; playit becomes <NAME>-playit.
# NAME=pz
