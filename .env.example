# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and edit:
#   cp .env.example .env
# `.env` holds your playit key + passwords — NEVER commit it.
#
# Values are passed to the container LITERALLY (docker-compose.yaml uses env_file
# format: raw). So do NOT put a trailing "# comment" on a KEY=VALUE line — the
# whole line after `=` becomes the value. Keep comments on their own lines.
#
# These are the danixu86 image's variable names (different from the old image).
# The image has extra knobs; the useful ones are here. A few classic settings
# (MAX PLAYERS, autosave interval, RCON port) are NOT env vars in this image —
# edit them in ./server-data/Zomboid/Server/<SERVERNAME>.ini after the first boot.
# ─────────────────────────────────────────────────────────────────────────────

# ── playit.gg ────────────────────────────────────────────────────────────────
# Secret key for the headless (container) agent. Generate one from this DIRECT
# link (easy to miss in the site's menus):
#   https://playit.gg/account/setup/wizard/new-account/docker/docker-name
# Name the agent, copy the secret. This is the "Docker" path — the "run it and
# click a claim URL" flow is playit's DESKTOP app (a different binary, not here).
# Without this the server still runs, but nobody can join over the internet.
PLAYIT_SECRET_KEY=

# ── Server identity ──────────────────────────────────────────────────────────
SERVERNAME=servername
# Password friends type to join (leave empty for no password):
PASSWORD=changeme-join
ADMINUSERNAME=admin
# In-game admin login — CHANGE THIS (mandatory; the server refuses to start
# without an admin password on first boot):
ADMINPASSWORD=changeme-admin

# ── Networking — tuned for a playit tunnel. Change with care. ────────────────
# playit forwards to the server's fixed bridge IP on 16261 (the game auto-uses
# 16262 as well). These match the danixu defaults; leave them unless you match
# server ports to your playit public ports (see docker-compose.yaml → "How
# friends connect").
PORT=16261
UDPPORT=16262
# Direct-connect (non-Steam) mode — the reliable path for a tunnelled server.
# If players still can't join, try flipping NOSTEAM to False and/or (un)checking
# "Use Steam Relay" in the client's connection options.
NOSTEAM=True
STEAMVAC=False
# Don't advertise in the in-game browser (the address is wrong behind a tunnel):
PUBLIC=False

# ── RCON — remote console password (port stays 27015/tcp, edit the .ini to
#    change it). Not published to the host by default. ────────────────────────
RCONPASSWORD=changeme-rcon

# ── Mods (optional) ──────────────────────────────────────────────────────────
# Semicolon-separated. NOTE: downloading Workshop mods requires SteamCMD, which
# means setting FORCEUPDATE=True for one run — and that step hits the 32-bit
# SteamCMD path that's unreliable on ARM64 hosts (incl. Apple Silicon). A vanilla
# server needs none of this. For B42, mod IDs may need backslash-escaping.
MOD_IDS=
WORKSHOP_IDS=
# FORCEUPDATE=True    # uncomment ONLY to force a SteamCMD update (see note above)

# ── JVM / resources ──────────────────────────────────────────────────────────
# Java heap (-Xms / -Xmx). 8G is comfortable for a normal group; drop MAX_MEMORY
# to 4096m if it's only a few players.
MIN_MEMORY=2048m
MAX_MEMORY=8192m
TZ=UTC

# ── Deployment knobs (substituted into docker-compose.yaml) ──────────────────
# Total container RAM (keep comfortably above MAX_MEMORY; use 6g if you dropped
# MAX_MEMORY to 4096m):
CONTAINER_MEMORY=10g
CONTAINER_CPUS=8
# Seconds allowed for the world to save on stop (numeric, no "s" suffix):
# STOP_GRACE=120
# Container name prefix (playit becomes <NAME>-playit). Usually leave alone:
# NAME=pz
